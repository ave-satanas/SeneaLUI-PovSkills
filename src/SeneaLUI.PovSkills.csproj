<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SeneaLUI.PovSkills</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <!-- Copies of the game/BepInEx/SeneaL DLLs live in ../lib (git-ignored); originals are never touched.
       Path of Valheiman is reached by reflection only, so it is not referenced. -->
